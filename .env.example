# ============================================================================
#  RM Remark Quality API — Environment Variables
# ============================================================================
#  Copy this file to .env and edit as needed.
#  All variables are prefixed with RM_ to avoid collisions.
# ============================================================================

# ── Artifact Path ────────────────────────────────────────────────────────
# Absolute path to the directory containing model artifacts.
# Default: ./artifacts (relative to project root)
# RM_ARTIFACT_DIR=./artifacts

# ── API Security ─────────────────────────────────────────────────────────
# API key for authenticated endpoints.  Leave empty to disable auth.
RM_API_KEY=

# Max requests per rate-limit window (per client IP)
RM_RATE_LIMIT_REQUESTS=100

# Rate-limit window duration in seconds
RM_RATE_LIMIT_WINDOW_SECONDS=60

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.  Use * for unrestricted.
RM_CORS_ORIGINS=*

# ── Server ───────────────────────────────────────────────────────────────
RM_HOST=0.0.0.0
RM_PORT=8000
RM_WORKERS=1
RM_LOG_LEVEL=info

# ── Hugging Face ─────────────────────────────────────────────────────────
RM_HF_TOKEN=your_huggingface_token_here

# ── Versioning ───────────────────────────────────────────────────────────
RM_MODEL_VERSION=1.0.0
RM_BUILD_TIMESTAMP=2026-09-01T00:00:00Z

# ── Batch ────────────────────────────────────────────────────────────────
# Maximum number of records in a single batch request
RM_MAX_BATCH_SIZE=500
